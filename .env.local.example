# Leave BACKEND_URL unset (e.g. on Vercel) to build the demo storefront from the
# bundled snapshot in src/data/ + public/products/ (see README).
BACKEND_URL=http://127.0.0.1:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp/contact numbers are plain constants in src/lib/contact.ts, not env vars.
# There is no payment gateway — applications are confirmed by the sales team over WhatsApp.
